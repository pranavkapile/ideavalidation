# Copy to .env and edit. start.sh / start.bat create .env from this file on first run.

# Port the web page is served on: http://localhost:PORT
PORT=8000

# Speech-to-text model size: tiny | base | small | medium | large-v3-turbo
# base  = 4-core laptops (default)      small = 8+ cores      large-v3-turbo = GPU only
WHISPER_MODEL=base

# Languages to load for translation (each one costs RAM and first-start download time)
LANGUAGES=en,es,fr,de,hi

# Text-to-speech voice per language (https://huggingface.co/rhasspy/piper-voices).
# Languages missing here get captions only.
VOICES=en=en_US-lessac-medium,es=es_ES-davefx-medium,fr=fr_FR-siwis-medium,de=de_DE-thorsten-medium,hi=hi_IN-pratham-medium
